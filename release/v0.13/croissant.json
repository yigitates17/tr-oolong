 "@type": "sc:Dataset",
 "name": "TR-OOLONG",
 "description": "A long-context aggregation benchmark for Turkish with English counterparts: documents of thousands of labelled records (up to 16M tokens, no record repeated within a document) and questions about label counts over the whole document, some users or some dates. Turkish sets, Turkish-English parallel and same-task pairs, English sets, and a close-comparison extension. Licences per set and who declared them: provenance.json.",
 "conformsTo": [
  "http://mlcommons.org/croissant/1.0",
  "http://mlcommons.org/croissant/RAI/1.0"
 ],
 "url": "https://huggingface.co/datasets/yigitates17/tr-oolong",
 "version": "0.13.0",
