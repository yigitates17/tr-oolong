{
  "source_path": "datasets/massive_tr.parquet",
  "text_col": "utt",
  "label_col": "intent",
  "entity_col": "scenario",
  "language": "tr",
  "min_words": 1,
  "min_class_support": 0,
  "seed": 42,
  "dirichlet_alpha": 5.0,
  "haystacks_per_length": 5,
  "questions_per_haystack": 12,
  "proportion_unit": "auto",
  "top_k_k": 3,
  "reference_tokenizer": "Qwen/Qwen3-8B",
  "out_dir": "tr_intent_paired_out",
  "pair_seed": true,
  "min_rank_margin": 0.03,
  "min_answer_count": 10,
  "haystack_target_records": [
    3000,
    6000
  ]
}
